# Supabase Configuration (Required)
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL (Required for SEO/OG images)
# In production, this should be your actual domain
NEXT_PUBLIC_SITE_URL=https://theflames.app

# Rate Limiting (Optional)
# Uses Upstash Redis. If not provided, falls back to in-memory rate limiting.
KV_REST_API_URL=https://your-redis.upstash.io
KV_REST_API_TOKEN=your-token

# Cron Job Security (Required for production)
# Secret token to protect cron endpoints from unauthorized access
CRON_SECRET=your-secret-token

# Development Flags
# Set to true to use mock data instead of real API calls
USE_MOCK_DATA=false

# Sentry (Optional - for error tracking)
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
